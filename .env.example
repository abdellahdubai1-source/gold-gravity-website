# ==============================================================
# Gold Gravity Trading LLC — Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ==============================================================

# --- Supabase (required) ---------------------------------------
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Service role key — server-side ONLY. Used by admin/server actions
# and the seed script. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Site configuration ------------------------------------------
# Used for canonical URLs, sitemap.xml and Organization JSON-LD.
NEXT_PUBLIC_SITE_URL=https://goldgravityuae.com

# --- NOT set here on purpose --------------------------------------
# The WhatsApp number, main call number, contact email and Google
# Analytics ID are stored in the `site_settings` database table and
# are edited from Admin > Settings — they are intentionally NOT read
# from environment variables, so changing them never requires a
# redeploy. The seed script (`npm run seed`) writes the approved
# defaults (WhatsApp +971 50 502 3438) into that table the first time
# it runs.
